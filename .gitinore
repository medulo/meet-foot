# Environnement virtuel Python
venv/
env/
__pycache__/
*.pyc

# Base de données locale (ne doit jamais être envoyée sur GitHub)
*.db

# Fichiers envoyés par les utilisateurs (photos, vidéos, messages vocaux)
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/audio/*
!app/static/audio/.gitkeep

# Fichiers système
.DS_Store
